{
  "name": "chess-legal-backend",
  "version": "1.0.0",
  "description": "离线国际象棋合法走子与王安全核验后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "main": "dist/src/cli.js",
  "bin": {
    "chess-legal": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "npm run build && node dist/src/cli.js serve",
    "demo": "npm run build && node dist/src/demo.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
